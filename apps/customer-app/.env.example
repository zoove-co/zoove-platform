# Copy to .env (git-ignored) for local runs. EAS builds set these per profile in eas.json.
# Address of the Zoove API. Required in production builds; the app refuses to start without it.
EXPO_PUBLIC_API_URL=https://zoove-api-pug9.onrender.com
# Development only: set to "true" to use the built-in fake API (no network). Ignored in production builds.
EXPO_PUBLIC_USE_MOCK=false
