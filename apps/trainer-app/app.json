{
  "expo": {
    "name": "Zoove Trainer",
    "slug": "zoove-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zoovetrainer",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.zoove.trainer",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.zoove.trainer",
      "adaptiveIcon": {
        "backgroundColor": "#4B18F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-notifications",
      ["expo-splash-screen", { "backgroundColor": "#4B18F8", "image": "./assets/images/splash-icon.png", "imageWidth": 200 }],
      "expo-secure-store",
      ["expo-image-picker", { "cameraPermission": "Zoove uses your camera to photograph your ID documents and take your selfie for KYC.", "photosPermission": "Zoove uses your photos so you can choose pictures of your ID documents and certificates." }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
