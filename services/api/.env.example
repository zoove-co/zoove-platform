# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
PORT=3000

# Supabase: use the pooled connection string (Settings > Database). Local Postgres works too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# At least 32 characters each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-jwt-change-me-jwt-change-me-jwt
OTP_SECRET=change-me-otp-change-me-otp-change-me-otp

# Development only: every OTP becomes this code. The API refuses to start with it in production.
DEV_FIXED_OTP=123456

# console prints OTPs to the log: development only. The API refuses it when NODE_ENV=production.
# msg91 sends real SMS (needs a DLT-approved OTP template).
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
SWAGGER_ENABLED=true
# Set to true behind a load balancer (AWS ALB). If left false there, every customer shares ONE rate limit.
TRUST_PROXY=false

# --- Trainer onboarding (web page now, trainer app later) ---
# Encrypts PAN numbers in the database. 32+ characters, different from the other secrets. REQUIRED in production.
PII_SECRET=change-me-pii-change-me-pii-change-me-pii
# Private file storage for KYC documents (Supabase Storage uses the S3 protocol; AWS S3 later needs only new values).
# Supabase: Storage > S3 Connection gives the endpoint and lets you create the access keys.
STORAGE_PROVIDER=none
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://gxhpqzsffqjunswjgljn.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=trainer-docs
# Emails: console prints them in the log. resend sends real mail (needs a verified sender domain).
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Zoove <hello@zoove.co>
# Team alerts for new trainer applications (comma separated).
OPS_NOTIFY_EMAILS=
# Links used inside emails.
TRAINER_SITE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
