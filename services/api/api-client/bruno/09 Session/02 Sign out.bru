meta {
  name: Sign out
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
}

assert {
  res.status: eq 204
}

docs {
  Ends this device. Always 204.
}
