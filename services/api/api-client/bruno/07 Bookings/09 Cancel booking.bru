meta {
  name: Cancel booking
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/bookings/{{bookingId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
}

assert {
  res.status: eq 201
}

tests {
  test("cancelled", function () {
    const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
    expect(Boolean(res.body.status === 'cancelled')).to.equal(true);
  });
}

docs {
  Cancelling twice is not an error.
}
