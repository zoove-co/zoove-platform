meta {
  name: Get one booking
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/bookings/{{bookingId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
}

assert {
  res.status: eq 200
}

tests {
  test("can change", function () {
    const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
    expect(Boolean(res.body.canChange === true)).to.equal(true);
  });
}

docs {
  canChange says whether cancel and reschedule are still allowed.
}
