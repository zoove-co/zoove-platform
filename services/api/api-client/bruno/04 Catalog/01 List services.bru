meta {
  name: List services
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/services
  body: none
  auth: none
}

script:post-response {
  const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
}

assert {
  res.status: eq 200
}

tests {
  test("has services", function () {
    const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
    expect(Boolean(res.body.length > 0)).to.equal(true);
  });
  test("prices are in paise", function () {
    const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
    expect(Boolean(typeof res.body[0].pricePaise.scheduled === 'number')).to.equal(true);
  });
}

docs {
  Active services with styles and prices in paise (no sign-in needed).
}
