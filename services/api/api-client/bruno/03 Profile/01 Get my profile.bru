meta {
  name: Get my profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
}

assert {
  res.status: eq 200
}

tests {
  test("phone matches", function () {
    const v = (k) => bru.getVar(k) ?? bru.getEnvVar(k);
    expect(Boolean(res.body.phone === v('phone'))).to.equal(true);
  });
}

docs {
  The signed-in customer.
}
